Embedded host: the transmit threads end, and the host waits for them.

With 0001 a transmit thread noticed tq_term() only while its queue was
empty: one busy sending (or waiting for a clear channel) kept going after
the host had closed the audio device, and after the next tq_init() it
took frames from the new queue as a second consumer.  It now checks the
flag while it waits for the channel and between frames, and counts
itself out (xmit_threads_active, xmit_thread_exiting) so that the host can
wait for it before audio_close().

From SATER Map; applies to Dire Wolf 1.8 after 0001.

--- a/src/xmit.c
+++ b/src/xmit.c
@@ -205,6 +205,44 @@
 static struct audio_s *save_audio_config_p;
 
 
+/* Embedded host: the host waits for the transmit threads to end */
+/* (xmit_threads_active) before it closes the audio device and starts */
+/* the modem again.  A thread left running would write to a closed */
+/* device and, after the next tq_init, take frames from the new queue. */
+
+static volatile int xmit_active_threads = 0;
+
+/* Set in each transmit thread, so that xmit_thread_exiting() can tell */
+/* whether the thread about to end is one of them. */
+
+#if defined(_MSC_VER)
+static __declspec(thread) int xmit_is_xmit_thread = 0;
+#else
+static _Thread_local int xmit_is_xmit_thread = 0;
+#endif
+
+int xmit_threads_active (void)
+{
+	return (xmit_active_threads);
+}
+
+/* Called by a transmit thread when it returns, and by the host's exit() */
+/* replacement on whatever thread is ending. */
+
+void xmit_thread_exiting (void)
+{
+	if ( ! xmit_is_xmit_thread) {
+	  return;
+	}
+	xmit_is_xmit_thread = 0;
+#if defined(__GNUC__) || defined(__clang__)
+	__atomic_sub_fetch (&xmit_active_threads, 1, __ATOMIC_SEQ_CST);
+#else
+	InterlockedDecrement ((volatile LONG *)&xmit_active_threads);
+#endif
+}
+
+
